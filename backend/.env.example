# Corner backend configuration (copy to .env)
CORNER_DATABASE_URL=sqlite:///./corner.db        # prod: postgresql+psycopg://user:pass@host/db
CORNER_AUTH_MODE=dev                              # dev | jwt
CORNER_JWT_SECRET=                                # HS256 secret from your auth provider (Supabase: project JWT secret)
CORNER_BRIEF_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=                              # leave unset → deterministic template briefs
